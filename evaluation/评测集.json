{
  "version": "1.0",
  "created": "2026-10-08",
  "purpose": "视频知识库问答的回归评测集。改检索参数 / 改提示词 / 重入库之后跑一遍，做前后对比。",
  "how_to_run": "python eval.py            # 跑全部\npython eval.py --only F01,F02  # 只跑指定题\npython eval.py --baseline  # 存为基线",
  "scoring": {
    "hit_rate": "expect 里的要点有多少个出现在答案里（子串匹配）",
    "refuse_ok": "拒答题：答案必须含拒答标志词",
    "intent_ok": "chatflow 自报意图是否等于 expect_intent",
    "forbid": "forbid 里的词一个都不许出现（例如「来源：」）",
    "retrieval": {
      "p_at_1": "第 1 名是不是期望视频的片段",
      "mrr": "期望视频首次出现的排名的倒数（越接近 1 越好）",
      "noise": "检索结果里非期望视频的片段占比",
      "meta_seg": "检索结果里纯元数据段的条数（2026-10-08 起应为 0）"
    },
